# Berrux - Raspberry Pi 5 (BCM2712), 64-bit.
#
# Produces output/images/berrux-pi5.img: a two-partition SD card image with a
# FAT boot partition (config.txt, cmdline.txt, the kernel and the Pi 5 device
# tree) and an ext4 root partition.
#
# On the kernel: a Pi 5's SD card, USB and Ethernet sit behind the RP1
# southbridge, which mainline 6.1 does not support and mainline 6.6 still does
# not drive. Booting to a shell therefore uses the Raspberry Pi 6.6 branch with
# its own bcm2712_defconfig. It is pinned to a branch, not a commit, so a
# rebuild always fetches the latest 6.6 fixes but is not byte-for-byte
# reproducible; swap in a commit hash if you need that.

# Architecture
BR2_aarch64=y
BR2_cortex_a76=y

# System
BR2_TARGET_GENERIC_HOSTNAME="berrux"
BR2_TARGET_GENERIC_ISSUE="Welcome to Berrux"
BR2_SYSTEM_DHCP="eth0"

# Berrux files
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BERRUX_PATH)/board/berrux/post-build.sh"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BERRUX_PATH)/board/berrux/overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_BERRUX_PATH)/board/berrux/pi5/post-image.sh"

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# BR2_TARGET_ROOTFS_TAR is not set

# Linux headers same as kernel
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/raspberrypi/linux/archive/refs/heads/rpi-6.6.y.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# SD card image
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
