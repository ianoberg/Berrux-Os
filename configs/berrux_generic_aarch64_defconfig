# Berrux - generic aarch64 starting point.
#
# This builds a small Berrux image for the QEMU "virt" machine, which runs on
# any x86 or ARM host with qemu-system-aarch64. Use it as the template for a
# real board: copy it, then swap the kernel/DT settings for your hardware.

# Architecture
BR2_aarch64=y
BR2_cortex_a53=y

# System
BR2_TARGET_GENERIC_HOSTNAME="berrux"
BR2_TARGET_GENERIC_ISSUE="Welcome to Berrux"
BR2_SYSTEM_DHCP="eth0"

# Berrux files
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BERRUX_PATH)/board/berrux/post-build.sh"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BERRUX_PATH)/board/berrux/overlay"

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# BR2_TARGET_ROOTFS_TAR is not set

# Linux headers same as kernel
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_1=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.1.44"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
