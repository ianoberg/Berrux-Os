# Berrux desktop packages.
#
# live-task-lxqt is the Debian live team's LXQt set; it brings the desktop and
# the live-session plumbing together. The rest is what a beginner reaches for
# in the first ten minutes.

live-task-lxqt
lxqt

# Network: Wi-Fi needs both the manager and its tray applet.
network-manager
network-manager-gnome

# Browser and basics.
firefox-esr
sudo
nano
curl
ca-certificates

# Firmware, so Wi-Fi and Bluetooth work on real laptops and the Pi.
firmware-iwlwifi
firmware-realtek
firmware-misc-nonfree

# Fonts: LXQt defaults look broken without these.
fonts-dejavu
fonts-noto-color-emoji
