#!/bin/sh
#
# berrux-info - what this system is, in one screen.
#
set -eu

if [ -r /etc/berrux-release ]; then
	. /etc/berrux-release
fi

NAME="${NAME:-Berrux}"
VERSION="${VERSION:-unknown}"
BASE="${BASE:-unknown base}"
AUTHORS="${AUTHORS:-Ian, with help from Mischa}"

printf '\n'
printf '  %s %s\n' "$NAME" "$VERSION"
printf '  %s\n' "$BASE"
printf '\n'
printf '  Kernel : %s\n' "$(uname -r)"
printf '  Machine: %s\n' "$(uname -m)"
if [ -r /proc/meminfo ]; then
	printf '  Memory : %s\n' "$(awk '/^MemTotal:/ {printf "%.1f GiB", $2 / 1048576}' /proc/meminfo)"
fi
printf '\n'
printf '  %s\n' "$AUTHORS"
printf '\n'
