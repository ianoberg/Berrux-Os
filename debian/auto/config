#!/bin/sh
#
# Berrux desktop edition - live-build configuration.
#
# Executed by "lb config" (and by debian/build.sh). Every option is explicit so
# a build is reproducible from a clean checkout instead of depending on
# whatever defaults the installed live-build happens to have.
#
# Override the architecture for a quick demo build on an x86 machine:
#   BERRUX_ARCH=amd64 ./build.sh
#
set -eu

ARCH="${BERRUX_ARCH:-arm64}"
DIST="${BERRUX_DIST:-trixie}"

# Note: live-build 2025 removed the old --hostname/--username options. The live
# session's hostname and user are set through live-config boot parameters in
# --bootappend-live below, and /etc/hostname is shipped in includes.chroot for
# anything that does not go through live-config.

# arm64 has no legacy BIOS, so it boots through UEFI only. x86 keeps both so
# the ISO works in old VMs as well as new machines.
case "$ARCH" in
	amd64|i386) BOOTLOADERS="syslinux,grub-efi" ;;
	*)          BOOTLOADERS="grub-efi" ;;
esac

lb config noauto \
	--architectures "$ARCH" \
	--distribution "$DIST" \
	--archive-areas "main contrib non-free non-free-firmware" \
	--binary-images iso-hybrid \
	--bootloaders "$BOOTLOADERS" \
	--bootappend-live "boot=live components quiet splash username=berrux hostname=berrux user-fullname=Berrux" \
	--debian-installer none \
	--memtest none \
	--firmware-chroot true \
	--apt-recommends true \
	--updates true \
	--security true \
	--iso-application "Berrux" \
	--iso-volume "BERRUX" \
	--iso-publisher "Berrux - Ian, with help from Mischa" \
	"$@"
