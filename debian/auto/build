#!/bin/sh
#
# Build step. live-build executes this from "lb build"; the "noauto" argument
# stops it from calling this script again.
#
set -eu

lb build noauto "$@"

ARCH="$(cat config/architectures 2>/dev/null || echo unknown)"
STAMP="$(date -u +%Y%m%d)"

# live-build names the output live-image-<arch>.hybrid.iso; give it a name a
# human can pick out of a downloads folder.
ISO="live-image-${ARCH}.hybrid.iso"
if [ -f "$ISO" ]; then
	OUT="berrux-${STAMP}-${ARCH}.iso"
	mv -f "$ISO" "$OUT"
	echo "Berrux: built $OUT ($(du -h "$OUT" | cut -f1))"
else
	echo "Berrux: build finished but $ISO is missing - read the log above." >&2
	exit 1
fi
